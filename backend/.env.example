# ---------------------------------------------------------------------------
# PC Monitor backend - copy to .env and fill in real values.
# NEVER commit the resulting .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development              # development | production
DEBUG=false
LOG_LEVEL=INFO

# Frontend origin allowed through CORS (production: your Vercel URL)
FRONTEND_URL=http://localhost:3000
# Optional extra origins, comma separated
EXTRA_CORS_ORIGINS=

# --- Firebase (server side ONLY - never exposed to the browser or the EXE) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escapes exactly as produced by the service account JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Alternative to the three variables above: path to the service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Use the in-process store instead of Firestore (dev / tests only)
USE_INMEMORY_DB=false

# --- Security ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
DEVICE_AUTH_SECRET=change-me-to-a-long-random-string
# Password that unlocks the dashboard (required in production)
DASHBOARD_PASSWORD=change-me

# --- Retention / thresholds ---
TELEMETRY_RETENTION_DAYS=7             # hard maximum is 7
ONLINE_THRESHOLD_SECONDS=120
DEFAULT_TELEMETRY_INTERVAL_SECONDS=30
MAX_TELEMETRY_POINTS=1500
MAX_FUTURE_CLOCK_SKEW_SECONDS=300

# --- Request protection ---
MAX_REQUEST_BYTES=65536
RATE_LIMIT_TELEMETRY_PER_MINUTE=12
RATE_LIMIT_HEARTBEAT_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_HOUR=30
RATE_LIMIT_DASHBOARD_PER_MINUTE=300

# --- Cleanup / TTL ---
CLEANUP_INTERVAL_MINUTES=30
CLEANUP_BATCH_SIZE=400
CLEANUP_PAGE_SIZE=200
CLEANUP_MAX_PAGES_PER_RUN=50
ENABLE_TTL_POLICY=true
# Shared secret for POST /internal/cleanup (X-Cleanup-Token)
CLEANUP_SECRET=change-me-too