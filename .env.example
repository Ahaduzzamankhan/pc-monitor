# ---------------------------------------------------------------------------
# PC Monitor - root environment template (documentation only).
# Each application reads its own variables:
#   backend/  -> backend/.env
#   frontend/ -> frontend/.env.local
#   agent     -> environment variables or %LOCALAPPDATA%\PC-Monitor\config.json
#
# NEVER commit real values. Firebase Admin credentials belong to the backend
# only - they must never reach the browser or PC-Monitor.exe.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DEVICE_AUTH_SECRET=generate-with-secrets-token-urlsafe-32
TELEMETRY_RETENTION_DAYS=7
FRONTEND_URL=https://your-dashboard.vercel.app
ENVIRONMENT=production
CLEANUP_SECRET=another-long-random-string

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-api.example.com

# --- Agent (set on each PC, or bake into config.json) ----------------------
API_URL=https://your-api.example.com
TELEMETRY_INTERVAL_SECONDS=30